# Copy this file to .env.local and fill in the values. Add the same names in Vercel under Settings, then
# Environment Variables, for the live site. Never paste the secret ones into a chat or an email.

# Supabase database address (Project Settings, then API Keys). Safe to show in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key, starts with sb_publishable_. Safe to show in the browser; it can't open any table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret. Supabase secret key, starts with sb_secret_. Server only: every write goes through it.
SUPABASE_SECRET_KEY=

# Secret. Stripe secret key (Developers, then API keys). Starts with sk_test_ until you say go live.
STRIPE_SECRET_KEY=
# Secret. The webhook endpoint's signing secret (Developers, then Webhooks). Starts with whsec_. Live site only.
STRIPE_WEBHOOK_SECRET=
# No Stripe price id: the price is set in lib/offer.ts, so a price change is one edit.

# Secret. Anthropic API key (console.anthropic.com, then API Keys), for the quiz summary and the plan.
ANTHROPIC_API_KEY=
# Optional. The fast model that reads the quiz answers. Leave blank for claude-haiku-5-5.
ANTHROPIC_MODEL_INTAKE=
# Optional. The model that writes the plan. Leave blank for claude-sonnet-5-5.
ANTHROPIC_MODEL_PLAN=

# No email key: the plan link goes out with Supabase's sign in email.

# Optional. The Meta pixel id, once there is one. Leave blank and no pixel loads.
NEXT_PUBLIC_META_PIXEL_ID=

# The live site's address, once it has one (https://tallyher.com). Used in share previews and in links from
# emails and Stripe.
NEXT_PUBLIC_SITE_URL=
